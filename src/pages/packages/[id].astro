---
import type { GetStaticPaths } from 'astro';
import FamilyArt from '../../components/FamilyArt.astro';
import Base from '../../layouts/Base.astro';
import {
  deprecationNote,
  formatCount,
  installSnippets,
  nugetUrl,
  packagePath,
  recommendedVersion,
  type FamilyGroup,
} from '../../lib/catalog';
import { getCatalog } from '../../lib/data';
import type { Package } from '../../lib/nuget';

export const getStaticPaths = (async () => {
  const { sections } = await getCatalog();
  return sections.flatMap((s) =>
    s.families.flatMap((group) =>
      group.packages.map((pkg) => ({ params: { id: pkg.id.toLowerCase() }, props: { pkg, group } })),
    ),
  );
}) satisfies GetStaticPaths;

interface Props {
  pkg: Package;
  group: FamilyGroup;
}

const { pkg, group } = Astro.props;
const { family } = group;
const version = recommendedVersion(pkg);
const siblings = group.packages.filter((p) => p.id !== pkg.id);
const VISIBLE_VERSIONS = 12;
const typeLabel: Record<string, string> = { DotnetTool: '.NET tool', Template: 'Template pack' };
const art = pkg.iconUrl ? ({ kind: 'image', src: pkg.iconUrl } as const) : group.art;
---

<Base title={`${pkg.id} — bielu packages`} description={pkg.description || `${pkg.id} on NuGet.`}>
  <nav class="crumbs">
    <a href="/">Packages</a> / <a href={`/#${family.slug}`}>{family.name}</a>
  </nav>

  <header class="hero">
    <div class="title">
      <FamilyArt art={art} hue={group.hue} size={84} />
      <h1>{pkg.id}</h1>
    </div>
    <div class="badges">
      <span class="badge accent mono">{version}</span>
      {pkg.version !== version && <span class="badge mono">next: {pkg.version}</span>}
      {typeLabel[pkg.type] && <span class="badge accent">{typeLabel[pkg.type]}</span>}
      {pkg.verified && <span class="badge">verified owner</span>}
      {pkg.deprecation && <span class="badge warn">deprecated</span>}
    </div>
    {pkg.description && <p class="lede">{pkg.description}</p>}

    {
      pkg.deprecation && (
        <p class="notice" role="note">
          <strong>⚠ {deprecationNote(pkg)}</strong>
          {pkg.deprecation.alternatePackage && (
            <>
              {' '}
              <a href={nugetUrl(pkg.deprecation.alternatePackage.id)}>See {pkg.deprecation.alternatePackage.id} →</a>
            </>
          )}
        </p>
      )
    }

    <ul class="stats">
      <li><b>{formatCount(pkg.totalDownloads)}</b><span>downloads</span></li>
      <li><b>{pkg.versions.length}</b><span>versions</span></li>
    </ul>

    <div class="links">
      <a href={nugetUrl(pkg.id)}>NuGet</a>
      {family.docs && <a href={family.docs}>Documentation</a>}
      {family.repo && <a href={family.repo}>Source</a>}
      {pkg.projectUrl && pkg.projectUrl !== family.docs && pkg.projectUrl !== family.repo && <a href={pkg.projectUrl}>Project site</a>}
    </div>
  </header>

  <section>
    <h2>Install</h2>
    <p class="sub">
      {pkg.stableVersion ? 'Latest stable release.' : 'No stable release yet — these pin the latest prerelease.'}
    </p>
    {
      installSnippets(pkg).map((s) => (
        <figure class="snippet">
          <figcaption>
            {s.label}
            <button type="button" data-copy>Copy</button>
          </figcaption>
          <pre><code>{s.code}</code></pre>
        </figure>
      ))
    }
  </section>

  {
    pkg.tags.length > 0 && (
      <section>
        <h2>Tags</h2>
        <p class="tags">
          {pkg.tags.map((t) => (
            <a class="badge" href={`https://www.nuget.org/packages?q=tags%3A${encodeURIComponent(t)}`}>
              {t}
            </a>
          ))}
        </p>
      </section>
    )
  }

  <section>
    <h2>Versions</h2>
    <p class="sub">Newest first, with per-version downloads.</p>
    <ol class="versions">
      {
        pkg.versions.map((v, i) => (
          <li class:list={{ more: i >= VISIBLE_VERSIONS }}>
            <a class="mono" href={nugetUrl(pkg.id, v.version)}>
              {v.version}
            </a>
            <span class="mono">{formatCount(v.downloads)}</span>
          </li>
        ))
      }
    </ol>
    {
      pkg.versions.length > VISIBLE_VERSIONS && (
        <button type="button" class="show-all" data-show-all>
          Show all {pkg.versions.length} versions
        </button>
      )
    }
  </section>

  {
    siblings.length > 0 && (
      <section>
        <h2>More from {family.name}</h2>
        <p class="sub">{group.summary}</p>
        <ul class="siblings">
          {siblings.map((p) => (
            <li>
              <a class="mono" href={packagePath(p.id)}>
                {p.id}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      const code = button.closest('figure')!.querySelector('code')!.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      setTimeout(() => (button.textContent = 'Copy'), 1500);
    });
  }

  document.querySelector<HTMLButtonElement>('[data-show-all]')?.addEventListener('click', (e) => {
    document.querySelector('.versions')!.classList.add('expanded');
    (e.currentTarget as HTMLElement).remove();
  });
</script>

<style>
  .hero { padding: 28px 0 48px; }
  .title { display: flex; align-items: center; gap: 20px; margin-bottom: 18px; }
  .title h1 { margin: 0; font-size: clamp(1.7rem, 5vw, 2.8rem); }
  @media (max-width: 520px) { .title { flex-direction: column; align-items: flex-start; } }
  .badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .badges .badge { text-transform: none; letter-spacing: 0; font-size: 12px; }
  .stats { margin-bottom: 28px; }
  .notice {
    margin: 20px 0 0;
    padding: 12px 16px;
    border-radius: 10px;
    background: var(--warn-soft);
    color: var(--fg);
    font-size: 15px;
  }
  .notice a { color: var(--accent); }

  .snippet {
    margin: 0 0 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-elev);
    overflow: hidden;
  }
  figcaption {
    display: flex; justify-content: space-between; align-items: center;
    padding: 7px 8px 7px 14px;
    font-size: 12.5px; font-weight: 600; color: var(--fg-muted);
    border-bottom: 1px solid var(--border);
  }
  button {
    font: inherit; font-size: 12.5px; font-weight: 500;
    color: var(--fg-muted);
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: 7px;
    padding: 3px 10px;
    cursor: pointer;
  }
  button:hover { color: var(--accent); border-color: var(--accent); }
  pre { margin: 0; padding: 14px; overflow-x: auto; font-size: 13.5px; line-height: 1.55; }

  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 0; }
  .tags .badge { text-decoration: none; text-transform: none; letter-spacing: 0; font-size: 13px; padding: 3px 10px; }
  .tags .badge:hover { color: var(--accent); border-color: var(--accent); }

  .versions, .siblings { list-style: none; margin: 0; padding: 0; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: var(--bg-elev); }
  .versions li, .siblings li { padding: 7px 14px; font-size: 14px; }
  .versions li { display: flex; justify-content: space-between; gap: 12px; }
  .versions li + li, .siblings li + li { border-top: 1px solid var(--border); }
  .versions li.more { display: none; }
  .versions.expanded li.more { display: flex; }
  .versions a, .siblings a { text-decoration: none; overflow-wrap: anywhere; }
  .versions a:hover, .siblings a:hover { color: var(--accent); }
  .versions span { color: var(--fg-faint); }
  .show-all { margin-top: 12px; }
</style>
